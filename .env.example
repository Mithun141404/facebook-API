# ─── App ────────────────────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ─── Security ────────────────────────────────────────────────
# The CRM must send this key in the X-API-Key header on every request
API_KEY=change-me-to-a-secure-random-string

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres@localhost/facebook_crm_db

# ─── Token Encryption ────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPT_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# ─── Facebook Graph API ──────────────────────────────────────
FB_GRAPH_API_VERSION=v19.0
FB_DEFAULT_POST_LIMIT=25

# ─── Proxy API ────────────────────────────────────────────────
LARAVEL_BACKEND_URL=http://localhost:8000
